# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Multi-Provider Cloud LLM Gateway (Phase 3B & Phase 4) ───────────────────────

# 1. Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Groq (Ultra-fast LPU inference: ~500+ tokens/sec)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter (Multi-model cascading & fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Comma-separated list of fallback models for OpenRouter cascade
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free,qwen/qwen-2.5-72b-instruct:free

# 4. GLM (Zhipu AI BigModel Platform)
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4-flash

# ── Local SLM / Offline Buffer (Ollama) ─────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── HITL auto-approve (set to 1 for non-interactive / CI use) ───────────────────
# HITL_AUTO=0
